{
  "name": "ApplicantLoginOtp",
  "type": "object",
  "properties": {
    "applicant_id": {
      "type": "string",
      "description": "ID of the Applicant this one-time login code was issued to"
    },
    "email": {
      "type": "string",
      "description": "Applicant email the code was dispatched to"
    },
    "otp_hash": {
      "type": "string",
      "description": "SHA-256 HMAC of the 6-digit code; plaintext is never persisted"
    },
    "expires_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the code expires (10 minutes after issue)"
    },
    "sent_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the most recent dispatch; used to enforce the 60-second resend throttle"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Failed verification attempts for the current code; locks at 5"
    },
    "consumed_at": {
      "type": "string",
      "description": "ISO 8601 timestamp set when the code is successfully verified; null while pending"
    }
  },
  "required": [
    "applicant_id",
    "email",
    "otp_hash",
    "expires_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}