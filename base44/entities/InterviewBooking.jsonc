{
  "name": "InterviewBooking",
  "type": "object",
  "properties": {
    "applicant_id": {
      "type": "string",
      "description": "Applicant this AI interview booking belongs to"
    },
    "variant_id": {
      "type": "number",
      "description": "Locked case variant assigned at shortlist time"
    },
    "slot_datetime": {
      "type": "string",
      "description": "ISO 8601 UTC datetime of the booked appointment"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone label captured at booking for local display"
    },
    "status": {
      "type": "string",
      "enum": [
        "booked",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "booked"
    },
    "session_id": {
      "type": "string",
      "description": "InterviewSession id once the interview has started"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_sent_at": {
      "type": "string"
    },
    "reschedule_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "applicant_id",
    "slot_datetime",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}