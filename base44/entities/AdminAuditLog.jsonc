{
  "name": "AdminAuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "add",
        "edit",
        "deactivate",
        "activate",
        "role_change"
      ]
    },
    "target_email": {
      "type": "string"
    },
    "target_role": {
      "type": "string"
    },
    "old_role": {
      "type": "string",
      "description": "Previous role before a role change"
    },
    "new_role": {
      "type": "string",
      "description": "New role after a role change"
    },
    "old_status": {
      "type": "string",
      "description": "Previous active status (active/inactive) before a change"
    },
    "new_status": {
      "type": "string",
      "description": "New active status (active/inactive) after a change"
    },
    "performed_by": {
      "type": "string",
      "description": "Email of the admin user who performed the action"
    },
    "performed_at": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "target_email",
    "performed_by"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}