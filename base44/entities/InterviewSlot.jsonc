{
  "name": "InterviewSlot",
  "type": "object",
  "properties": {
    "slot_datetime": {
      "type": "string",
      "description": "ISO datetime of the interview slot"
    },
    "location": {
      "type": "string",
      "description": "Interview location or meeting link"
    },
    "interviewer": {
      "type": "string",
      "description": "Name of the interviewer assigned to this slot"
    },
    "is_booked": {
      "type": "boolean",
      "default": false
    },
    "booked_by_applicant_id": {
      "type": "string",
      "description": "Applicant ID who booked this slot"
    },
    "pending_lock": {
      "type": "string",
      "description": "ISO timestamp set when a booking is in-flight; cleared once booked"
    },
    "interview_mode": {
      "type": "string",
      "enum": [
        "structured_digital",
        "live_panel",
        "legacy_unspecified"
      ],
      "default": "live_panel",
      "description": "structured_digital = auto-generated portal slots. live_panel = admin-created manual panel slots (default for admin-created slots)."
    }
  },
  "required": [
    "slot_datetime"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}