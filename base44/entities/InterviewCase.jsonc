{
  "name": "InterviewCase",
  "type": "object",
  "properties": {
    "variant_id": {
      "type": "number",
      "description": "Case variant number 1-8"
    },
    "title": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "description": "Full written scenario brief shown to the candidate"
    },
    "common_rules": {
      "type": "string",
      "description": "Shared rules: max 5 slides/plan, 8-min presentation, 3 core follow-ups + up to 2 adaptive, 15-20 min total"
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to 5 concise slide/plan prompts the candidate may present"
    },
    "follow_up_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "5 curated follow-up questions testing changed assumptions, next actions, metrics, ethics, defence of numbers"
    },
    "rubric_focus": {
      "type": "string",
      "description": "Which rubric dimensions this case emphasises (server-side only, never shown to candidate)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "variant_id",
    "title",
    "scenario"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}